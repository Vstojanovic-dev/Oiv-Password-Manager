# =============================================================================
# Docker
# =============================================================================

# MySQL data files — regenerated automatically by the container
data/mysql/

# Backup files generated by the app — these contain decrypted passwords
data/www/backend/backups/


# =============================================================================
# PHP
# =============================================================================

# Temporary hash generation script — should never be committed
data/www/backend/genhash.php

# PHP error logs
*.log
error_log


# =============================================================================
# Frontend (React)
# =============================================================================

# Dependencies — installed locally via npm/yarn
data/www/frontend/node_modules/

# Production build output
data/www/frontend/build/
data/www/frontend/dist/

# Local environment files
data/www/frontend/.env
data/www/frontend/.env.local
data/www/frontend/.env.*.local


