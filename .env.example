APP_ENV=development
APP_SECRET=replace-with-random-32-character-value

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_TIMEOUT_MINUTES=15

DB_NAME=password_manager
DB_USER=replace-with-local-db-user
DB_PASSWORD=replace-with-local-db-password
DB_PORT=3306
MYSQL_ROOT_PASSWORD=replace-with-local-root-password

BACKUP_DIR=/var/app/backups
BACKUP_MAX_BYTES=2097152
BACKUP_MAX_ACCOUNTS=1000
JSON_REQUEST_MAX_BYTES=1048576
